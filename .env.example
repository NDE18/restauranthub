# =============================================================================
# RestaurantHub — Variables d'environnement
# =============================================================================
# Copier ce fichier : cp .env.example .env
# Ne JAMAIS commiter le fichier .env (il est dans .gitignore)
# =============================================================================

# --- PostgreSQL (partagé par toutes les instances) ---------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Noms des bases de données par service
POSTGRES_USER_DB=user_db
POSTGRES_RESTAURANT_DB=restaurant_db
POSTGRES_RESERVATION_DB=reservation_db
POSTGRES_ORDER_DB=order_db
POSTGRES_PAYMENT_DB=payment_db
POSTGRES_LOYALTY_DB=loyalty_db
POSTGRES_DELIVERY_DB=delivery_db
POSTGRES_ANALYTICS_DB=analytics_db

# --- MongoDB -----------------------------------------------------------------
MONGO_USER=mongo
MONGO_PASSWORD=mongo

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=redis_secret

# --- Keycloak (IAM) ----------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Meilisearch (recherche full-text) ----------------------------------------
MEILISEARCH_KEY=masterKey_dev_only

# --- NextAuth.js (frontend) --------------------------------------------------
NEXTAUTH_SECRET=dev-secret-change-in-production

# --- Stripe (paiements) — utiliser des clés de test --------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Notifications (optionnel en dev) -----------------------------------------
SENDGRID_API_KEY=placeholder
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
