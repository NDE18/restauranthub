    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/config": "^3.2.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/bull": "^10.2.1",
    "bull": "^4.16.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.4.0",
    "ioredis": "^5.3.2",
    "socket.io": "^4.7.5",
    "@sendgrid/mail": "^8.1.3",
